{
  "name": "ai-chat-history-auto-delete",
  "version": "1.0.0",
  "description": "Chrome extension that automatically deletes old Claude chats. You pick how far back (default: 30 days). Runs in your browser \u2014 nothing leaves your device.",
  "private": true,
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "build": "node scripts/build-extension.mjs",
    "build:css": "tailwindcss -i src/styles/input.css -o src/styles/auto-delete.css --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration-test.js dryrun",
    "test:integration:delete": "node scripts/integration-test.js delete",
    "lint": "eslint .",
    "release": "node scripts/release.mjs",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "release:dry": "node scripts/release.mjs --dry-run",
    "bump": "commit-and-tag-version",
    "bump:dry": "commit-and-tag-version --dry-run"
  },
  "lint-staged": {
    "*.{js,cjs,mjs}": "eslint --max-warnings 0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "archiver": "^7.0.1",
    "canvas": "^3.2.1",
    "commit-and-tag-version": "^13.1.2",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "tailwindcss": "3",
    "vitest": "^4.1.0"
  },
  "dependencies": {}
}
