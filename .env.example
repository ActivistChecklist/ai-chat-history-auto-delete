# Copy to .env and fill in. `.env` is gitignored; `.env.example` is committed.
# Loaded automatically by `yarn build` and `yarn release`.

# 1Password secret reference for the Chrome extension CRX signing key.
# This is a POINTER, not the key itself — the private key never leaves 1Password
# except into a temp file during signing. Find it in the 1Password app:
# right-click the field -> "Copy Secret Reference".
OP_SIGNING_KEY_REF="op://<vault>/<item>/private key"
